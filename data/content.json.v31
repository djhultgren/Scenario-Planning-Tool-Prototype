 [
  "sub",
  "Retention by acquisition value and age band"
 ],
 [
  "figure",
  5,
  "Retention by gift amount",
  "Note: 82% of €5-a-month donors are in fact giving €60 once a year. Because the retention rates of donors giving at this level are projected for the full ten years, and we do not have the age splits, they have been excluded from the age views."
 ],
 [
  "p",
  "Retention does not decline significantly as we ask for more. Within every age group it falls but only slightly: at 40–49, 67% of €10 donors are still giving after a year against 60% of €20 donors."
 ],
 [
  "takeaway",
  "However, the additional income at €20 more than makes up for it.  Donor age matters far more when it comes to retention than gift amount.",
  "Key Takeaway"
 ],
 [
  "h3",
  "4",
  "What we pay for donors"
 ],
 [
  "p",
  "We will spend €5.5m to raise €13.5m. Averages across the five agencies hide how differently they charge, and how different the donors they recruit are."
 ],
 [
  "figure",
  6,
  "CPA and 10-year net LTV by agency",
  ""
 ],
 [
